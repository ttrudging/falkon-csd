+// Falkon CSD: delegate window-edge and corner resize to the Wayland compositor.
+// Never manipulate window geometry during a mouse drag (preserves KWin tiling).
+namespace {
+class FalkonCsdResizeGrip final : public QWidget
+{
+public:
+    FalkonCsdResizeGrip(QWidget *parent, Qt::Edges edges, Qt::CursorShape cursor)
+        : QWidget(parent), m_edges(edges)
+    {
+        setObjectName(QStringLiteral("FalkonCsdResizeGrip"));
+        setCursor(cursor);
+        setMouseTracking(true);
+    }
+
+protected:
+    void mousePressEvent(QMouseEvent *event) override
+    {
+        if (event->button() == Qt::LeftButton) {
+            if (QWindow *handle = window()->windowHandle()) {
+                if (handle->startSystemResize(m_edges)) {
+                    event->accept();
+                    return;
+                }
+            }
+        }
+        QWidget::mousePressEvent(event);
+    }
+
+private:
+    Qt::Edges m_edges;
+};
+
+class FalkonCsdResizeHandles final : public QObject
+{
+public:
+    explicit FalkonCsdResizeHandles(QWidget *top) : QObject(top), m_top(top)
+    {
+        struct Definition { Qt::Edges edges; Qt::CursorShape cursor; };
+        const Definition definitions[] = {
+            {Qt::TopEdge, Qt::SizeVerCursor},
+            {Qt::BottomEdge, Qt::SizeVerCursor},
+            {Qt::LeftEdge, Qt::SizeHorCursor},
+            {Qt::RightEdge, Qt::SizeHorCursor},
+            {Qt::TopEdge | Qt::LeftEdge, Qt::SizeFDiagCursor},
+            {Qt::TopEdge | Qt::RightEdge, Qt::SizeBDiagCursor},
+            {Qt::BottomEdge | Qt::LeftEdge, Qt::SizeBDiagCursor},
+            {Qt::BottomEdge | Qt::RightEdge, Qt::SizeFDiagCursor},
+        };
+        for (const auto &d : definitions) {
+            m_grips.push_back(new FalkonCsdResizeGrip(top, d.edges, d.cursor));
+        }
+        top->installEventFilter(this);
+        updateGrips();
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (watched == m_top && (event->type() == QEvent::Resize
+                                 || event->type() == QEvent::Show
+                                 || event->type() == QEvent::WindowStateChange)) {
+            updateGrips();
+        }
+        return false;
+    }
+
+private:
+    void updateGrips()
+    {
+        const bool enabled = !m_top->isMaximized() && !m_top->isFullScreen();
+        const int w = m_top->width(), h = m_top->height();
+        constexpr int edge = 7, corner = 13;
+        const QRect shapes[] = {
+            {corner, 0, qMax(0, w - 2 * corner), edge},
+            {corner, h - edge, qMax(0, w - 2 * corner), edge},
+            {0, corner, edge, qMax(0, h - 2 * corner)},
+            {w - edge, corner, edge, qMax(0, h - 2 * corner)},
+            {0, 0, corner, corner},
+            {w - corner, 0, corner, corner},
+            {0, h - corner, corner, corner},
+            {w - corner, h - corner, corner, corner},
+        };
+        for (int i = 0; i < m_grips.size(); ++i) {
+            QWidget *grip = m_grips.at(i);
+            grip->setGeometry(shapes[i]);
+            grip->setVisible(enabled && w > 2 * corner && h > 2 * corner);
+            if (enabled) grip->raise();
+        }
+    }
+
+    QWidget *m_top;
+    QVector<QWidget *> m_grips;
+};
+}
